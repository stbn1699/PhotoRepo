# Copie ce fichier en ".env" et remplis-le.

# Nom affiché sur la page de connexion et en haut du site
SITE_NAME=Galerie

# Compte admin créé au premier démarrage (ignoré ensuite si un admin existe déjà)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-moi

# Mot de passe de la base de données (lettres et chiffres uniquement, sans caractères spéciaux)
DB_PASSWORD=change-moi-aussi

# --- Docker (NAS) ---
# Chemin du dossier partagé Photographie sur le Synology
PHOTOS_PATH=/volume1/Photographie
# Port du NAS sur lequel le site répond (à cibler avec le reverse proxy)
APP_PORT=3011
# Port du NAS pour ouvrir la base dans DBeaver (réseau local uniquement, ne pas l'ouvrir sur Internet)
DB_PORT=3012

# --- Dev local uniquement (npm run dev) ---
# La base tourne dans Docker : docker compose -f docker-compose.yml -f docker-compose.dev.yml up -d db
DATABASE_URL=postgres://photorepo:change-moi-aussi@localhost:5433/photorepo
# (chemin relatif au dossier server/, ou chemin absolu)
PHOTOS_ROOT=../dev-photos
# (ou directement le partage du NAS : PHOTOS_ROOT=//192.168.1.89/Photographie)
CACHE_DIR=../data/dev-cache
